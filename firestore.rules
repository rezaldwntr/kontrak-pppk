rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi pembantu: verifikasi bahwa pengguna telah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Koleksi data kepegawaian (PII ASN/PPPK) dan riwayat perpanjangan
    // HANYA dapat dibaca dan ditulis oleh pengguna yang telah login
    match /database/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Koleksi konfigurasi sistem (template dokumen, data pihak pertama, drive sync settings)
    // HANYA dapat diakses oleh pengguna yang telah login
    match /config/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Koleksi antrian sync Google Drive
    match /sync_queue/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Tolak semua akses ke dokumen lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
